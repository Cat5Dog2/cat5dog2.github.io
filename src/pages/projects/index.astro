---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="Projects | Cat5Dog2 Portfolio"
  description="Cat5Dog2の個人開発・実績ページ一覧です。"
  breadcrumbs={[
    { name: 'Home', path: '' },
    { name: 'Projects', path: 'projects/' },
  ]}
>
  <main id="main" class="l-section">
    <div class="l-container">
      <SectionHeading
        as="h1"
        eyebrow="Projects"
        title="制作実績"
        lead="要件・受け入れ条件の文書化から運用まで一貫して取り組み、すべて本番環境で公開している作品です。"
      />
      <div class="l-grid l-grid--2">
        {projects.map((project) => <ProjectCard project={project} as="h2" />)}
      </div>
    </div>
  </main>
</BaseLayout>
