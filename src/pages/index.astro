---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MetricCard from '../components/MetricCard.astro';
import SkillOverview from '../components/SkillOverview.astro';
import { projects } from '../data/projects';
import { withBase } from '../utils/paths';

const guestDemoCount = projects.filter((project) => project.demo.access === 'guest').length;
const guestDemoNote =
  guestDemoCount === projects.length
    ? 'すべて登録不要のゲストログインで試せます'
    : `うち${guestDemoCount}本は登録不要のゲストログインで試せます`;
---

<BaseLayout>
  <main id="main">
    <section class="hero">
      <div class="l-container hero__grid">
        <div>
          <p class="eyebrow">Web Engineer — .NET / TypeScript / Azure</p>
          <h1 class="hero__title">
            仕様書から、
            <span>本番環境まで。</span>
          </h1>
          <p class="lead">
            要件定義・受け入れ条件の文書化から、実装、E2Eテスト、CI/CD、クラウド運用設計まで。Web集客・EC・業務システム開発の実務で得たドメイン知識を、.NET・TypeScript・Azureでのプロダクト開発に活かしています。
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href="#projects">制作実績を見る</a>
            <a class="button button--ghost" href="https://github.com/Cat5Dog2" target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </div>

        <aside class="hero-panel" aria-label="強みの要約">
          <dl class="hero-panel__list">
            <div class="hero-panel__item">
              <dt>Now</dt>
              <dd>グローバルIT企業でインターン（技術検証・プロジェクト推進）</dd>
            </div>
            <div class="hero-panel__item">
              <dt>Stack</dt>
              <dd>.NET / TypeScript / React / Azure / Docker</dd>
            </div>
            <div class="hero-panel__item">
              <dt>Delivery</dt>
              <dd>仕様駆動開発：要件・設計・受け入れ条件 → 実装 → 検証</dd>
            </div>
            <div class="hero-panel__item">
              <dt>Domain</dt>
              <dd>SEO・CMSの実務知識を、記事作成・SEO分析ツールの要件に活用</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="l-section--compact">
      <div class="l-container metric-grid">
        <MetricCard
          value={`${projects.length}本`}
          label="本番環境で公開中のWebアプリ"
          note={`Azure App Service / Firebase + Cloud Run / VPS（Docker Compose）。${guestDemoNote}`}
        />
        <MetricCard value="4/4" label="全リポジトリでCIを運用" note="GitHub Actionsで自動検証。3リポジトリは本番へのCDまで整備し、PetHealth・Web Writing ToolはPlaywright E2EもCIで実行" />
        <MetricCard value="docs/" label="要件・設計・テスト仕様を文書化" note="要件定義・基本設計・受け入れ条件を各リポジトリで公開" />
      </div>
    </section>

    <section id="projects" class="l-section">
      <div class="l-container">
        <SectionHeading
          eyebrow="Projects"
          title="制作実績"
          lead={`${projects.length}作品とも本番環境で公開中です。詳細ページでは、デモの入口・設計資料・技術判断を確認できます。`}
        />
        <div class="l-grid l-grid--2">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>

    <section id="skills" class="l-section u-surface-soft">
      <div class="l-container">
        <SectionHeading
          eyebrow="Skills"
          title="技術スタック"
          lead="実務で使った技術と、個人開発で使った技術を分けています。個人開発の技術は、使用した作品から実装を確認できます。"
        />
        <SkillOverview />
      </div>
    </section>

    <section class="l-section">
      <div class="l-container l-grid l-grid--2">
        <div>
          <SectionHeading
            eyebrow="Career"
            title="Web運営から開発・IT実務へ領域を拡大"
            lead="メディア運営からWeb制作、EC、受託開発と進み、現在はグローバルIT企業でインターン中です。"
          />
          <a class="button button--ghost" href={withBase('career/')}>職務要約を見る</a>
        </div>
        <div class="note-card">
          <p class="eyebrow">This Site is Code</p>
          <h3>このポートフォリオ自体がコード品質のサンプルです</h3>
          <p class="u-muted">
            CSS Cascade Layersによる詳細度に依存しない設計、Custom Propertiesによるデザイントークン、セマンティックHTML。Astroの静的生成で、JavaScriptバンドルは<strong class="note-card__highlight">0KB</strong>。これが高速表示の理由です。
          </p>
          <a class="button button--ghost note-card__cta" href="https://github.com/Cat5Dog2/cat5dog2.github.io" target="_blank" rel="noreferrer">ソースコードを見る</a>
        </div>
      </div>
    </section>

    <section id="contact" class="l-section contact-section">
      <div class="l-container contact-card">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>お気軽にご連絡ください</h2>
          <p>ご連絡はメールでお願いします。GitHubとXのプロフィールもご覧いただけます。</p>
        </div>
        <div class="contact-card__actions">
          <a class="button button--primary" href="mailto:cat5dog2.tskhrcm@gmail.com">メールを送る</a>
          <a class="button button--ghost" href="https://github.com/Cat5Dog2" target="_blank" rel="noreferrer">GitHubを見る</a>
          <a class="button button--ghost" href="https://x.com/Cat5Dog2" target="_blank" rel="noreferrer">Xのプロフィールを見る</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
