---
import type { Project } from '../data/projects';
import { demoAccessLabels } from '../data/projects';
import ProjectThumbnail from './ProjectThumbnail.astro';
import { withBase } from '../utils/paths';

interface Props {
  project: Project;
  /** 配置先セクションの見出し階層に合わせて指定する */
  as?: 'h2' | 'h3';
}

const { project, as = 'h3' } = Astro.props as Props;
const Heading = as;
---

{/* 画面 → 用途 → 技術・担当 → 詳細への導線の順に読ませる */}
<a class="project-card" href={withBase(project.slug)}>
  <ProjectThumbnail preview={project.preview} />
  <div class="project-card__meta">
    <p class="project-card__category">{project.category}</p>
    <span class:list={['access-badge', `access-badge--${project.demo.access}`]}>
      {demoAccessLabels[project.demo.access]}
    </span>
  </div>
  <Heading class="project-card__title">{project.title}</Heading>
  <p class="project-card__summary">{project.summary}</p>
  <dl class="project-card__facts">
    <div>
      <dt>担当</dt>
      <dd>{project.role}</dd>
    </div>
    <div>
      <dt>現在</dt>
      <dd>{project.stage}</dd>
    </div>
  </dl>
  <ul class="tag-list project-card__tags" role="list" aria-label={`${project.title} の使用技術`}>
    {project.stack.map((tech) => <li class="tag">{tech}</li>)}
  </ul>
  {/* ホバーのないタッチ端末でも、カード全体が詳細ページへのリンクだと分かるようにする */}
  <span class="project-card__more">詳細を見る<span aria-hidden="true"> →</span></span>
</a>
