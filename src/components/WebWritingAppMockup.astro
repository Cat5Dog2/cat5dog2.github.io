---
import { Image } from 'astro:assets';

import imgArticleList from '../assets/portfolio/webwriting/article-list.png';
import imgArticleCreate from '../assets/portfolio/webwriting/article-create.png';
import imgOutlineEditor from '../assets/portfolio/webwriting/outline-editor.png';
import imgArticlePreview from '../assets/portfolio/webwriting/article-preview.png';
import imgBulkCreate from '../assets/portfolio/webwriting/bulk-create.png';
import imgBulkProgress from '../assets/portfolio/webwriting/bulk-progress.png';

const tabs = [
  { id: 'webwriting-tab-article-list', label: '記事一覧', img: imgArticleList, alt: '記事ごとのステータス、タイトル、操作ボタンを一覧表示する記事一覧画面' },
  { id: 'webwriting-tab-article-create', label: '記事作成', img: imgArticleCreate, alt: 'キーワード、見出し数、文体、生成モデルなどを指定する記事作成画面' },
  { id: 'webwriting-tab-outline-editor', label: '構成・本文編集', img: imgOutlineEditor, alt: '生成した見出し構成と本文、検索した参考情報を確認・編集する記事編集画面' },
  { id: 'webwriting-tab-article-preview', label: 'プレビュー', img: imgArticlePreview, alt: '目次と見出しごとの本文を確認する記事プレビュー画面' },
  { id: 'webwriting-tab-bulk-create', label: '一括作成', img: imgBulkCreate, alt: '複数のキーワードと生成・検索条件を指定する一括作成画面' },
  { id: 'webwriting-tab-bulk-progress', label: '一括生成の状況', img: imgBulkProgress, alt: 'キーワードごとの生成状況と停止操作を表示する一括生成の進捗画面' },
];
---

<div class="mockup-showcase">
  <div class="tab-list">
    <h3 id="webwriting-mockup-title" class="tab-title">機能一覧</h3>
    <div class="tab-buttons" role="radiogroup" aria-labelledby="webwriting-mockup-title">
      {tabs.map((tab, index) => (
        <label class="tab-button">
          <input
            type="radio"
            name="webwriting-mockup-tabs"
            id={tab.id}
            class="hidden-radio"
            checked={index === 0}
          />
          {tab.label}
        </label>
      ))}
    </div>
  </div>

  {/* PC向けアプリのため、モニター型の枠で表示する */}
  <div class="monitor">
    <div class="monitor__bezel">
      <div class="monitor__screen">
        {/* 画面ごとにスクロール領域を分け、切り替え時に別画面のスクロール位置を引き継がないようにする */}
        {tabs.map((tab) => (
          <div class={`screen-content content-${tab.id}`} tabindex="0" role="region" aria-label="選択した画面のプレビュー">
            <Image
              src={tab.img}
              alt={tab.alt}
              width={1600}
              widths={[800, 1200, 1600]}
              sizes="(min-width: 860px) 796px, calc(100vw - 44px)"
            />
          </div>
        ))}
        <p class="scroll-hint" aria-hidden="true">↓ Scroll ↓</p>
      </div>
      <div class="monitor__chin" aria-hidden="true"></div>
    </div>
    <div class="monitor__stand" aria-hidden="true">
      <div class="monitor__neck"></div>
      <div class="monitor__base"></div>
    </div>
  </div>
</div>

<style>
  .mockup-showcase {
    display: grid;
    gap: 1.5rem;
    padding-block: 1rem 2rem;
  }

  .hidden-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .tab-title {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }

  .tab-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tab-button {
    display: flex;
    align-items: center;
    padding: 0.6rem 1.1rem;
    border-radius: 0.5rem;
    background-color: #f3f4f6;
    color: #4b5563;
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.4;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tab-button:hover {
    background-color: #e5e7eb;
  }

  .tab-button:has(.hidden-radio:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* 白文字とのコントラスト比4.5:1以上を満たす色を使う */
  .tab-button:has(.hidden-radio:checked) {
    background-color: var(--color-accent-strong);
    color: #fff;
  }

  /* --- PCモニターのスタイル --- */
  .monitor__bezel {
    padding: clamp(6px, 1.4vw, 12px);
    padding-bottom: 0;
    border-radius: clamp(8px, 1.6vw, 16px);
    background-color: #1f2937;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 10px 10px -5px rgb(0 0 0 / 0.04);
  }

  .monitor__bezel:has(.screen-content:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .monitor__screen {
    position: relative;
    overflow: hidden;
    border-radius: 3px;
    aspect-ratio: 16 / 9;
    background-color: #fff;
  }

  /* 下ベゼル中央の電源ランプ風の装飾 */
  .monitor__chin {
    display: grid;
    height: clamp(16px, 3vw, 28px);
    place-items: center;
  }

  .monitor__chin::before {
    width: clamp(4px, 0.6vw, 6px);
    border-radius: 50%;
    aspect-ratio: 1;
    background-color: #4b5563;
    content: '';
  }

  .monitor__stand {
    display: grid;
    justify-items: center;
  }

  .monitor__neck {
    width: 14%;
    height: clamp(22px, 5vw, 48px);
    background: linear-gradient(90deg, #111827, #374151 50%, #111827);
    clip-path: polygon(12% 0, 88% 0, 100% 100%, 0 100%);
  }

  .monitor__base {
    width: 34%;
    height: clamp(6px, 1.1vw, 10px);
    border-radius: 999px 999px 4px 4px;
    background: linear-gradient(180deg, #374151, #1f2937);
    box-shadow: 0 10px 18px -8px rgb(15 23 42 / 0.45);
  }

  .screen-content {
    position: absolute;
    inset: 0;
    display: none;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .screen-content::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .screen-content img {
    display: block;
    width: 100%;
    height: auto;
  }

  .scroll-hint {
    position: absolute;
    z-index: 1;
    bottom: 12px;
    left: 50%;
    display: none;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background-color: rgb(31 41 55 / 0.82);
    box-shadow: 0 4px 12px rgb(15 23 42 / 0.2);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1.5;
    pointer-events: none;
    white-space: nowrap;
    animation: scroll-hint-float 1.6s ease-in-out infinite;
  }

  @keyframes scroll-hint-float {
    0%,
    100% {
      transform: translate(-50%, 0);
    }

    50% {
      transform: translate(-50%, -8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      animation: none;
      transform: translateX(-50%);
    }
  }

  /* --- CSS（Radio Button Hack）による切り替えロジック --- */

  /* 画面より縦に長いスクリーンショットだけスクロールを案内する */
  .mockup-showcase:has(#webwriting-tab-article-create:checked) .scroll-hint,
  .mockup-showcase:has(#webwriting-tab-outline-editor:checked) .scroll-hint,
  .mockup-showcase:has(#webwriting-tab-article-preview:checked) .scroll-hint,
  .mockup-showcase:has(#webwriting-tab-bulk-create:checked) .scroll-hint,
  .mockup-showcase:has(#webwriting-tab-bulk-progress:checked) .scroll-hint {
    display: block;
  }

  .mockup-showcase:has(#webwriting-tab-article-list:checked) .content-webwriting-tab-article-list,
  .mockup-showcase:has(#webwriting-tab-article-create:checked) .content-webwriting-tab-article-create,
  .mockup-showcase:has(#webwriting-tab-outline-editor:checked) .content-webwriting-tab-outline-editor,
  .mockup-showcase:has(#webwriting-tab-article-preview:checked) .content-webwriting-tab-article-preview,
  .mockup-showcase:has(#webwriting-tab-bulk-create:checked) .content-webwriting-tab-bulk-create,
  .mockup-showcase:has(#webwriting-tab-bulk-progress:checked) .content-webwriting-tab-bulk-progress {
    display: block;
  }

  @media (max-width: 520px) {
    .mockup-showcase {
      padding-block: 0.5rem 1rem;
    }

    .tab-buttons {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tab-button {
      min-height: 3rem;
      padding: 0.6rem 0.75rem;
      font-size: 0.82rem;
      line-height: 1.35;
    }

    .scroll-hint {
      bottom: 8px;
      font-size: 0.72rem;
    }
  }
</style>
