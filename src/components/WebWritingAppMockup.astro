---
import DesktopAppMockup from './DesktopAppMockup.astro';

import imgArticleList from '../assets/portfolio/webwriting/article-list.png';
import imgArticleCreate from '../assets/portfolio/webwriting/article-create.png';
import imgOutlineEditor from '../assets/portfolio/webwriting/outline-editor.png';
import imgArticlePreview from '../assets/portfolio/webwriting/article-preview.png';
import imgBulkCreate from '../assets/portfolio/webwriting/bulk-create.png';
import imgBulkProgress from '../assets/portfolio/webwriting/bulk-progress.png';

const screens = [
  { label: '記事一覧', img: imgArticleList, alt: '記事ごとのステータス、タイトル、操作ボタンを一覧表示する記事一覧画面' },
  { label: '記事作成', img: imgArticleCreate, alt: 'キーワード、見出し数、文体、生成モデルなどを指定する記事作成画面' },
  { label: '構成・本文編集', img: imgOutlineEditor, alt: '生成した見出し構成と本文、検索した参考情報を確認・編集する記事編集画面' },
  { label: 'プレビュー', img: imgArticlePreview, alt: '目次と見出しごとの本文を確認する記事プレビュー画面' },
  { label: '一括作成', img: imgBulkCreate, alt: '複数のキーワードと生成・検索条件を指定する一括作成画面' },
  { label: '一括生成の状況', img: imgBulkProgress, alt: 'キーワードごとの生成状況と停止操作を表示する一括生成の進捗画面' },
];
---

<DesktopAppMockup name="webwriting" screens={screens} />
