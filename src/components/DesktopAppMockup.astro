---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * PC向けアプリの画面プレビュー。タブで選んだ画面を、モニター型の枠の中に表示する。
 * JavaScriptを使わず、ラジオボタンと :has() だけで表示を切り替える。
 */
type DesktopScreen = {
  label: string;
  img: ImageMetadata;
  alt: string;
};

interface Props {
  /** ラジオボタンのname属性と見出しidの接頭辞。ページ内で一意にする */
  name: string;
  screens: DesktopScreen[];
}

const { name, screens } = Astro.props;

// 切り替えのCSSはタブと画面を並び順（nth-child）で対応付けているため、用意した件数を超えたらビルドで止める
const MAX_SCREENS = 8;
if (screens.length > MAX_SCREENS) {
  throw new Error(`DesktopAppMockup の画面は${MAX_SCREENS}件までです（${name}: ${screens.length}件）`);
}

const titleId = `${name}-mockup-title`;

// モニターの表示領域（16:9）より縦に長いスクリーンショットだけ、スクロールを案内する
const isScrollable = (img: ImageMetadata) => img.height * 16 > img.width * 9;
---

<div class="mockup-showcase">
  <div class="tab-list">
    <h3 id={titleId} class="tab-title">機能一覧</h3>
    <div class="tab-buttons" role="radiogroup" aria-labelledby={titleId}>
      {screens.map((screen, index) => (
        <label class:list={['tab-button', { 'tab-button--scrollable': isScrollable(screen.img) }]}>
          <input type="radio" name={`${name}-mockup-tabs`} class="hidden-radio" checked={index === 0} />
          {screen.label}
        </label>
      ))}
    </div>
  </div>

  {/* PC向けアプリのため、モニター型の枠で表示する */}
  <div class="monitor">
    <div class="monitor__bezel">
      <div class="monitor__screen">
        {/* 画面ごとにスクロール領域を分け、切り替え時に別画面のスクロール位置を引き継がないようにする */}
        {screens.map((screen) => (
          <div class="screen-content" tabindex="0" role="region" aria-label="選択した画面のプレビュー">
            <Image
              src={screen.img}
              alt={screen.alt}
              width={1600}
              widths={[800, 1200, 1600]}
              sizes="(min-width: 860px) 796px, calc(100vw - 44px)"
            />
          </div>
        ))}
        <p class="scroll-hint" aria-hidden="true">↓ Scroll ↓</p>
      </div>
      <div class="monitor__chin" aria-hidden="true"></div>
    </div>
    <div class="monitor__stand" aria-hidden="true">
      <div class="monitor__neck"></div>
      <div class="monitor__base"></div>
    </div>
  </div>
</div>

<style>
  .mockup-showcase {
    display: grid;
    gap: 1.5rem;
    padding-block: 1rem 2rem;
  }

  .hidden-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .tab-title {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }

  .tab-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tab-button {
    display: flex;
    align-items: center;
    padding: 0.6rem 1.1rem;
    border-radius: 0.5rem;
    background-color: #f3f4f6;
    color: #4b5563;
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.4;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tab-button:hover {
    background-color: #e5e7eb;
  }

  .tab-button:has(.hidden-radio:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* 白文字とのコントラスト比4.5:1以上を満たす色を使う */
  .tab-button:has(.hidden-radio:checked) {
    background-color: var(--color-accent-strong);
    color: #fff;
  }

  /* --- PCモニターのスタイル --- */
  .monitor__bezel {
    padding: clamp(6px, 1.4vw, 12px);
    padding-bottom: 0;
    border-radius: clamp(8px, 1.6vw, 16px);
    background-color: #1f2937;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 10px 10px -5px rgb(0 0 0 / 0.04);
  }

  .monitor__bezel:has(.screen-content:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .monitor__screen {
    position: relative;
    overflow: hidden;
    border-radius: 3px;
    aspect-ratio: 16 / 9;
    background-color: #fff;
  }

  /* 下ベゼル中央の電源ランプ風の装飾 */
  .monitor__chin {
    display: grid;
    height: clamp(16px, 3vw, 28px);
    place-items: center;
  }

  .monitor__chin::before {
    width: clamp(4px, 0.6vw, 6px);
    border-radius: 50%;
    aspect-ratio: 1;
    background-color: #4b5563;
    content: '';
  }

  .monitor__stand {
    display: grid;
    justify-items: center;
  }

  .monitor__neck {
    width: 14%;
    height: clamp(22px, 5vw, 48px);
    background: linear-gradient(90deg, #111827, #374151 50%, #111827);
    clip-path: polygon(12% 0, 88% 0, 100% 100%, 0 100%);
  }

  .monitor__base {
    width: 34%;
    height: clamp(6px, 1.1vw, 10px);
    border-radius: 999px 999px 4px 4px;
    background: linear-gradient(180deg, #374151, #1f2937);
    box-shadow: 0 10px 18px -8px rgb(15 23 42 / 0.45);
  }

  .screen-content {
    position: absolute;
    inset: 0;
    display: none;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .screen-content::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .screen-content img {
    display: block;
    width: 100%;
    height: auto;
  }

  .scroll-hint {
    position: absolute;
    z-index: 1;
    bottom: 12px;
    left: 50%;
    display: none;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background-color: rgb(31 41 55 / 0.82);
    box-shadow: 0 4px 12px rgb(15 23 42 / 0.2);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1.5;
    pointer-events: none;
    white-space: nowrap;
    animation: scroll-hint-float 1.6s ease-in-out infinite;
  }

  @keyframes scroll-hint-float {
    0%,
    100% {
      transform: translate(-50%, 0);
    }

    50% {
      transform: translate(-50%, -8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      animation: none;
      transform: translateX(-50%);
    }
  }

  /* --- CSS（Radio Button Hack）による切り替えロジック --- */

  /* 選択中の画面が表示領域より縦に長いときだけスクロールを案内する */
  .mockup-showcase:has(.tab-button--scrollable .hidden-radio:checked) .scroll-hint {
    display: block;
  }

  /* n番目のタブが選ばれたら、n番目の画面を表示する（MAX_SCREENS の件数分） */
  .mockup-showcase:has(.tab-button:nth-child(1) .hidden-radio:checked) .screen-content:nth-child(1),
  .mockup-showcase:has(.tab-button:nth-child(2) .hidden-radio:checked) .screen-content:nth-child(2),
  .mockup-showcase:has(.tab-button:nth-child(3) .hidden-radio:checked) .screen-content:nth-child(3),
  .mockup-showcase:has(.tab-button:nth-child(4) .hidden-radio:checked) .screen-content:nth-child(4),
  .mockup-showcase:has(.tab-button:nth-child(5) .hidden-radio:checked) .screen-content:nth-child(5),
  .mockup-showcase:has(.tab-button:nth-child(6) .hidden-radio:checked) .screen-content:nth-child(6),
  .mockup-showcase:has(.tab-button:nth-child(7) .hidden-radio:checked) .screen-content:nth-child(7),
  .mockup-showcase:has(.tab-button:nth-child(8) .hidden-radio:checked) .screen-content:nth-child(8) {
    display: block;
  }

  @media (max-width: 520px) {
    .mockup-showcase {
      padding-block: 0.5rem 1rem;
    }

    .tab-buttons {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tab-button {
      min-height: 3rem;
      padding: 0.6rem 0.75rem;
      font-size: 0.82rem;
      line-height: 1.35;
    }

    .scroll-hint {
      bottom: 8px;
      font-size: 0.72rem;
    }
  }
</style>
